{
    "name": "google/gtg-ads",
    "description": "Set up Google tag gateway for advertisers with PHP.",
    "license": "Apache-2.0",
    "type": "library",
    "homepage": "https://developers.google.com/tag-platform/tag-manager/gateway/setup-guide?setup=manual",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "phpunit/phpunit": "^9 || ^10 || ^11",
        "phpcompatibility/php-compatibility": "dev-develop#645a525bebce492b0c5808a1a8077ee72fa7b296",
        "php-stubs/wordpress-stubs": "^6.8",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "brain/monkey": "^2.6",
        "classpreloader/classpreloader": "^4.3",
        "classpreloader/console": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Google\\GoogleTagGatewayLibrary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
          "Google\\GoogleTagGatewayLibrary\\Tests\\": "tests/phpunit/includes"
        }
    },

    "scripts": {
        "lint": "phpcs",
        "fix": "phpcbf",
        "test": "phpunit",
        "generate": "classpreloader compile --config=bin/generate_measurement.php --output=dist/measurement.php",
        "post-autoload-dump": "@generate"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
