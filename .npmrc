engine-strict=false

# Several @woocommerce/* packages still declare a stale, narrow `engines.node`
# in their own package.json (from their own CI, not a real runtime
# requirement) that lags behind what this repo targets in its own `engines`
# field below. engine-strict=true would hard-fail installs on those alone.

# The legacy-peer-deps option eliminates React versioning conflicts in npm peer
# dependencies between @wordpress/* and @woocommerce/*. It should be removed
# after they don't have versioning conflicts.
legacy-peer-deps=true
