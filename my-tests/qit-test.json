{
    "package": "google-listings-and-ads/name",
    "package_type": "test",
    "requires": {
        "network": false
    },
    "test_type": "e2e",
    "test": {
        "phases": {
            "globalSetup": [
                "./bootstrap/global-setup.sh"
            ],
            "setup": [
                "./bootstrap/setup.sh"
            ],
            "run": [
                "npx playwright test"
            ],
            "teardown": [],
            "globalTeardown": [
                "./bootstrap/global-teardown.sh"
            ]
        },
        "results": {
            "ctrf-json": "./results/ctrf.json",
            "allure-dir": "./results/allure",
            "blob-dir": "./results/blob"
        }
    }
}
